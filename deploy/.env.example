# Authored by Tomás Neto (TN 2026)
# ---------------------------------------------------------------------------
# Settings for deploy/compose.yaml. Copy to .env next to compose.yaml and adjust.
# Everything is optional: an empty or missing .env starts a working sandbox gateway.
#
# Values here fill the ${...} in compose.yaml AND are passed to the gateway, so any setting
# from the project's main .env.example can be added below.
# Not needed here (handled by the stack): DATABASE_URL, REDIS_URL, APP_ENCRYPTION_KEY,
# POSTGRES_PASSWORD. They are generated into ./secrets on the first start.
# ---------------------------------------------------------------------------

# --- image -----------------------------------------------------------------
# Image without tag. Docker Hub by default; for a private registry use host[:port]/path
# and run `docker login <host>` first, e.g. MG_IMAGE=registry.example.com/infra/mail-gateway
MG_IMAGE=tomasneto26/mail_gateway
# Version to run: latest, or pin one, e.g. 1.0.3 (the migrations image is <tag>-migrate)
MG_TAG=latest

# --- network ---------------------------------------------------------------
# Host address the UI/API and Mailpit are published on. 127.0.0.1 = this machine only;
# 0.0.0.0 = every interface (put HTTPS in front first, see COOKIE_SECURE).
MG_BIND=127.0.0.1
MG_HTTP_PORT=3000
MG_MAILPIT_PORT=8025
# The "Sandbox Messages" link to Mailpit is set in the admin UI (Settings → Sandbox), not here.
# Docker network of the stack. Must not overlap a route on the host (VPN, LAN): check `ip route`.
MG_SUBNET=10.213.9.0/24
# Compose project name (container and network prefix)
MG_PROJECT=mailgw

# --- first administrator -----------------------------------------------------
# Created on the first start when no administrator exists. The password is generated:
# `docker compose logs admin` or ./secrets/admin_password
MG_ADMIN_EMAIL=admin@example.com

# --- backups -----------------------------------------------------------------
# pg_dump into ./backups every N hours (0 = off); older dumps are deleted after KEEP_DAYS.
# Keep ./secrets with them: message bodies are encrypted with the key stored there.
MG_BACKUP_INTERVAL_HOURS=24
MG_BACKUP_KEEP_DAYS=14

# --- web ---------------------------------------------------------------------
# Public base URL as seen by browsers. Required for Authentik SSO and behind a reverse proxy,
# e.g. https://mail-gw.example.com (no path). Empty = http://localhost:<MG_HTTP_PORT>.
PUBLIC_URL=
# false only for plain http on localhost. Set true as soon as the gateway is served over HTTPS.
COOKIE_SECURE=false
# Behind a reverse proxy: its address(es), so client IPs come from X-Forwarded-For
TRUST_PROXY=false
LOG_LEVEL=info

# --- live delivery (optional) ---------------------------------------------------
# Without a provider every key stays useful in sandbox mode (delivered to Mailpit only).
# Default provider for live/approval keys: smtp | resend
LIVE_PROVIDER=smtp
# Your existing relay. Empty SMTP_HOST = SMTP delivery off.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465); false = STARTTLS on 587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Resend (https://resend.com) instead of / next to SMTP
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Emails admin invitations through the live provider when set; otherwise the UI shows the link
SYSTEM_MAIL_FROM=
SYSTEM_MAIL_FROM_NAME=mail-gateway

# --- Authentik SSO (optional) ------------------------------------------------------
# Needs PUBLIC_URL. Redirect URI to register in Authentik: <PUBLIC_URL>/admin/auth/authentik/callback
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER=
# e.g. https://authentik.example.com/application/o/mail-gateway/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# --- sign-in policy ------------------------------------------------------------
# true = every local user must set up TOTP; false = optional per user
TOTP_REQUIRED=false
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# --- reputation guardrails (optional) -------------------------------------------
# Hourly recipient caps per destination domain, all keys combined (live/approval mail only)
# RECIPIENT_DOMAIN_LIMITS=gmail.com=200,outlook.com=200,*=1000
# Daily caps for the first days after a key leaves sandbox (empty = no warm-up)
# WARMUP_SCHEDULE=50,100,250,500,1000,2500,5000
# SPF / DKIM / DMARC of each key's sender domain: off | warn (shown in the UI) | enforce (blocks going live)
# SENDER_DOMAIN_CHECKS=off
# ClamAV daemon for keys with "Virus scan" on
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# --- alert rules (defaults shown; channels are configured in the UI) ------------
# ALERT_REJECTION_SPIKE=50
# ALERT_FAILURE_SPIKE=10
# ALERT_SPIKE_WINDOW_MINUTES=15
# ALERT_QUOTA_PERCENT=80
# ALERT_APPROVAL_WAIT_MINUTES=30
# ALERT_KEY_EXPIRY_DAYS=7
# ALERT_COOLDOWN_MINUTES=60

# --- guardrails and defaults for new keys (defaults shown) ----------------------
# DEDUP_WINDOW_SECONDS=600
# GLOBAL_ACCEPT_PER_HOUR=5000
# GLOBAL_RATE_MAX=10
# GLOBAL_RATE_DURATION_MS=1000
# DEFAULT_QUOTA_PER_HOUR=50
# DEFAULT_QUOTA_PER_DAY=200
# DEFAULT_MAX_RECIPIENTS=10
# AUDIT_BODY_RETENTION_DAYS=30
# AUDIT_RECORD_RETENTION_DAYS=365
