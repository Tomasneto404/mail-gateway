# Authored by Tomás Neto (TN 2026)
# ---------------------------------------------------------------------------
# mail-gateway configuration. Copy to .env and adjust.
# Every secret can also be provided as a Docker secret via <NAME>_FILE=/run/secrets/<file>
# (the file content wins only if <NAME> itself is empty). See compose.secrets.yml.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=production
# fatal | error | warn | info | debug | trace | silent  (JSON logs to stdout)
LOG_LEVEL=info
# HTTP port of the API inside the container
PORT=3000
# Internal-only port for /metrics, /health/* (api and worker). Not published by compose.
METRICS_PORT=9464
# Express "trust proxy": false | true | <hop count> | comma list of proxy IPs/CIDRs.
# Behind HAProxy set it to the HAProxy address(es) so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Hard limit for any request body (bytes). Base64 attachments must fit in this. Default 15 MB.
MAX_REQUEST_BYTES=15728640

# --- compose helpers (only read by docker-compose.yml) ---------------------
POSTGRES_USER=mailgw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mailgw
# Host interface/port the API is published on (keep 127.0.0.1 or an internal IP behind HAProxy)
API_BIND=127.0.0.1
API_PORT=3000
MAILPIT_UI_PORT=8025
# Images to run: [MAIL_GATEWAY_REGISTRY/]MAIL_GATEWAY_IMAGE:MAIL_GATEWAY_TAG (+ "-migrate" for migrations).
# Leave MAIL_GATEWAY_REGISTRY empty to build locally (mail-gateway:latest).
# To deploy from your own registry (images pushed by CI "Build & Push"):
#   MAIL_GATEWAY_REGISTRY=harbor.example.com      # host[:port], no https://  (docker.io for Docker Hub)
#   MAIL_GATEWAY_IMAGE=infra/mail-gateway           # repository path in the registry (= DOCKERHUB_REPOSITORY in CI)
#   MAIL_GATEWAY_TAG=1.2.0
#   docker login harbor.example.com
#   docker compose -f docker-compose.yml pull && docker compose -f docker-compose.yml up -d --no-build --wait
MAIL_GATEWAY_REGISTRY=
MAIL_GATEWAY_IMAGE=mail-gateway
MAIL_GATEWAY_TAG=latest
# Docker network for the stack. Must not overlap routes on the host (VPN, LAN): check `ip route`.
MAIL_GATEWAY_SUBNET=10.213.7.0/24

# --- datastores ------------------------------------------------------------
# Set automatically by docker-compose.yml; only needed when running outside compose.
# DATABASE_URL=postgresql://mailgw:change-me@localhost:5432/mailgw
# REDIS_URL=redis://localhost:6379

# --- admin API + admin UI --------------------------------------------------
# Disable the whole /admin API and UI login (the CLI keeps working).
ADMIN_API_ENABLED=true
# Static admin token: automation only, DISABLED by default. >= 32 chars (openssl rand -hex 32)
ADMIN_TOKEN_ENABLED=false
ADMIN_TOKEN=
# ADMIN_TOKEN_FILE=/run/secrets/admin_token

# Public base URL as seen by browsers (used for SSO redirect URIs and CSRF Origin checks).
# REQUIRED in production behind HAProxy, e.g. https://mail-gw.internal.example
PUBLIC_URL=
# Serve the admin UI at /ui
UI_ENABLED=true
# 32 random bytes, base64. REQUIRED for local admin users. Encrypts at rest: TOTP secrets, message
# bodies and attachments, alert channel targets; signs the activity-log hash chain. Keep it with your backups.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEY_FILE=/run/secrets/app_encryption_key
# Session cookies are Secure (__Host-mg_session). Only set false for plain-http local dev.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Local accounts (password, optional TOTP). Keep enabled as break-glass even with SSO.
LOCAL_LOGIN_ENABLED=true
# false (default): each local user may enable TOTP from the account menu; once enabled it is
#   required at every sign-in, and turning it off requires the current password.
# true: TOTP is mandatory for every local user (set up at first sign-in, cannot be disabled).
TOTP_REQUIRED=false
# Per-account lockout and per-IP login rate limit
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX=30
LOGIN_IP_WINDOW_SECONDS=900
INVITE_TTL_HOURS=48

# --- Authentik SSO (OIDC) ---------------------------------------------------
# See docs/authentik.md. Redirect URI to register: <PUBLIC_URL>/admin/auth/authentik/callback
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER=
# e.g. https://authentik.example.com/application/o/mail-gateway/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# AUTHENTIK_CLIENT_SECRET_FILE=/run/secrets/authentik_client_secret
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_GROUPS_CLAIM=groups
# Group → role mapping is configured per role in the admin UI (Roles › Authentik groups).
# Defaults: mail-gateway-admins → Admin, mail-gateway-viewers → Viewer,
#           mail-gateway-body-viewers → Body reader. No matching group = no access.

# --- guardrails ------------------------------------------------------------
# Identical (key, recipients, subject, body) within this window → DUPLICATE_MESSAGE. 0 disables.
DEDUP_WINDOW_SECONDS=600
# Idempotency-Key replay window
IDEMPOTENCY_TTL_SECONDS=86400
# Delivery pacing towards the provider (all workers combined): max jobs per duration.
GLOBAL_RATE_MAX=10
GLOBAL_RATE_DURATION_MS=1000
# Gateway-wide cap of accepted messages per UTC hour → GLOBAL_RATE_LIMITED
GLOBAL_ACCEPT_PER_HOUR=5000
# Parallel deliveries per worker process
WORKER_CONCURRENCY=4
# Failed authentication attempts per client IP per window before AUTH_RATE_LIMITED
AUTH_FAIL_MAX=20
AUTH_FAIL_WINDOW_SECONDS=300
# Hourly recipient caps per destination domain, all keys combined, for live/approval mail.
# "domain=perHour" list; "*" = every other domain; empty = no caps → DOMAIN_RATE_LIMITED
RECIPIENT_DOMAIN_LIMITS=
# Daily caps for day 1, 2, … after a key first leaves sandbox (per-key "warm-up" switch). Empty = off.
WARMUP_SCHEDULE=50,100,250,500,1000,2500,5000
# SPF / DKIM / DMARC of each key's sender domain: off | warn (shown on the key page) | enforce (blocks going live)
SENDER_DOMAIN_CHECKS=off
DKIM_SELECTORS=default,mail,dkim,selector1,selector2,google,k1,s1,s2,resend,smtp
# ClamAV daemon (clamd INSTREAM) for keys with "Virus scan". Unset + scan on = attachments refused.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# --- alerts --------------------------------------------------------------------
# Channels (webhook / Slack / email) are configured in the admin UI (Alerts). Rules, evaluated every minute:
ALERT_REJECTION_SPIKE=50
ALERT_FAILURE_SPIKE=10
ALERT_SPIKE_WINDOW_MINUTES=15
ALERT_QUOTA_PERCENT=80
ALERT_APPROVAL_WAIT_MINUTES=30
ALERT_KEY_EXPIRY_DAYS=7
# The same alert is not repeated within this window
ALERT_COOLDOWN_MINUTES=60

# --- delivery / retries ----------------------------------------------------
# Attempts for transient errors (4xx, network). Permanent 5xx are not retried.
DELIVERY_MAX_ATTEMPTS=6
# Exponential backoff base (ms): 30s, 60s, 120s, ...
DELIVERY_BACKOFF_MS=30000

# --- circuit breaker (per live provider) -----------------------------------
# Trip after N consecutive transport-level failures...
BREAKER_CONSECUTIVE_FAILURES=5
# ...or when failures/attempts in the window reach this ratio with at least MIN_SAMPLES attempts.
BREAKER_FAILURE_RATE=0.5
BREAKER_WINDOW_SECONDS=300
BREAKER_MIN_SAMPLES=10

# --- audit retention -------------------------------------------------------
# Message bodies + attachments are purged after this many days
AUDIT_BODY_RETENTION_DAYS=30
# Message rows, events, stats and admin audit are deleted after this many days
AUDIT_RECORD_RETENTION_DAYS=365
# Cron (UTC) for the retention job (worker)
RETENTION_CRON=17 3 * * *

# --- live providers --------------------------------------------------------
# Default provider for live/approval keys (a key may override it): smtp | resend
LIVE_PROVIDER=smtp

# Existing SMTP relay. Leave SMTP_HOST empty to disable the smtp provider.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465). false = connect plain then STARTTLS.
SMTP_SECURE=false
# Require STARTTLS when SMTP_SECURE=false (recommended)
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
# Worker only. Prefer SMTP_PASSWORD_FILE=/run/secrets/smtp_password
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=30000

# Resend (https://resend.com). The API key is only given to the worker.
RESEND_ENABLED=false
RESEND_API_KEY=
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# Override only for testing (stub server)
# RESEND_BASE_URL=
# Signing secret of the Resend webhook pointing at https://<gateway>/webhooks/resend (whsec_...)
RESEND_WEBHOOK_SECRET=

# --- system email (admin invitations) ----------------------------------------
# When set (and SMTP or Resend is enabled), invitations and password resets are emailed
# from this address through the live provider. Unset = the UI only shows the link to share.
SYSTEM_MAIL_FROM=
SYSTEM_MAIL_FROM_NAME=mail-gateway

# --- sandbox ---------------------------------------------------------------
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
# The "Sandbox Messages" link to Mailpit (and the internal URL used to check it) is set in the
# admin UI: Settings → Sandbox. Dev: the Mailpit UI is published on http://localhost:${MAILPIT_UI_PORT:-8025}

# --- CSV exports -------------------------------------------------------------
# Max rows per export (messages / activity log). Larger results are truncated
# (response header X-Export-Truncated: true); narrow the filters instead.
EXPORT_MAX_ROWS=100000

# --- defaults for new keys -------------------------------------------------
DEFAULT_QUOTA_PER_HOUR=50
DEFAULT_QUOTA_PER_DAY=200
DEFAULT_MAX_RECIPIENTS=10
DEFAULT_MAX_MESSAGE_BYTES=1048576
DEFAULT_MAX_ATTACHMENT_BYTES=5242880
